# Base URL for the backend API. Leave as /api in dev to use the Vite proxy
# defined in vite.config.ts (works around the backend not having CORS enabled).
# In production, point this at the real backend URL (with CORS enabled there).
VITE_API_BASE_URL=/api

# WhatsApp number used for product inquiries, digits only with country code
# (no + or spaces), e.g. 573115867095.
VITE_WHATSAPP_NUMBER=573115867095
